generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id             String             @id @default(cuid())
  name           String
  email          String             @unique
  emailVerified  Boolean            @default(false)
  image          String?
  phone          String?
  fatherName     String?
  motherName     String?
  role           Role               @default(MEMBER)
  status         UserStatus         @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  linkedPersonId String?            @unique
  accounts       account[]
  activityLogs   ActivityLog[]
  reviews        PersonSubmission[] @relation("ReviewedBy")
  submissions    PersonSubmission[] @relation("SubmittedBy")
  sessions       session[]

  @@map("users")
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Person {
  id                 String     @id @default(cuid())
  fullName           String
  nickname           String?
  gender             Gender
  isAlive            Boolean    @default(true)
  generationNumber   Int?
  familyBranch       String?
  fatherId           String?
  motherId           String?
  fatherNameFallback String?
  motherNameFallback String?
  birthDate          String?
  birthPlace         String?
  address            String?
  kelurahan          String?
  kecamatan          String?
  kabupaten          String?
  province           String?
  country            String?    @default("Indonesia")
  latitude           Float?
  longitude          Float?
  phone              String?
  deathDate          String?
  deathPlace         String?
  graveAddress       String?
  graveKelurahan     String?
  graveKecamatan     String?
  graveKabupaten     String?
  graveProvince      String?
  graveLatitude      Float?
  graveLongitude     Float?
  graveNotes         String?
  photoUrl           String?
  linkStatus         LinkStatus @default(UNLINKED)
  status             DataStatus @default(PENDING)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  adoptionsAsParent  Adoption[] @relation("AdoptiveParent")
  adoptionsAsChild   Adoption[] @relation("AdoptedChild")
  marriagesAsHusband Marriage[] @relation("Husband")
  marriagesAsWife    Marriage[] @relation("Wife")
  father             Person?    @relation("FatherChildren", fields: [fatherId], references: [id], onDelete: Cascade)
  childrenAsFather   Person[]   @relation("FatherChildren")
  mother             Person?    @relation("MotherChildren", fields: [motherId], references: [id], onDelete: Cascade)
  childrenAsMother   Person[]   @relation("MotherChildren")

  @@index([fatherId])
  @@index([motherId])
  @@index([linkStatus])
  @@index([generationNumber])
  @@map("persons")
}

model Marriage {
  id            String         @id @default(cuid())
  husbandId     String
  wifeId        String
  marriageDate  String?
  marriagePlace String?
  divorceDate   String?
  status        MarriageStatus @default(MARRIED)
  marriageOrder Int            @default(1)
  createdAt     DateTime       @default(now())
  husband       Person         @relation("Husband", fields: [husbandId], references: [id], onDelete: Cascade)
  wife          Person         @relation("Wife", fields: [wifeId], references: [id], onDelete: Cascade)

  @@index([husbandId])
  @@index([wifeId])
  @@map("marriages")
}

model Adoption {
  id               String   @id @default(cuid())
  childId          String
  adoptiveParentId String
  adoptionDate     String?
  notes            String?
  createdAt        DateTime @default(now())
  adoptiveParent   Person   @relation("AdoptiveParent", fields: [adoptiveParentId], references: [id], onDelete: Cascade)
  child            Person   @relation("AdoptedChild", fields: [childId], references: [id], onDelete: Cascade)

  @@map("adoptions")
}

model PersonSubmission {
  id               String     @id @default(cuid())
  submittedById    String
  personData       Json
  changeType       ChangeType
  targetPersonId   String?
  targetPersonName String?
  status           DataStatus @default(PENDING)
  adminNote        String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime   @default(now())
  reviewedBy       user?      @relation("ReviewedBy", fields: [reviewedById], references: [id])
  submittedBy      user       @relation("SubmittedBy", fields: [submittedById], references: [id])

  @@index([submittedById])
  @@index([status])
  @@map("person_submissions")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("activity_logs")
}

enum Gender {
  MALE
  FEMALE
}

enum LinkStatus {
  LINKED
  UNLINKED
}

enum DataStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MarriageStatus {
  MARRIED
  DIVORCED
  WIDOWED
}

enum ChangeType {
  ADD
  EDIT
  DELETE
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

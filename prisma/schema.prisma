// Prisma Schema — Silsilah Bani Abd. Mutthalib
// Sesuai PRD v1.1.0 Section 3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH TABLES (Better Auth)
// ============================================================

model user {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  fatherName    String?
  motherName    String?
  linkedPersonId String?    @unique
  role          Role      @default(MEMBER)
  status        UserStatus @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      session[]
  accounts      account[]
  submissions   PersonSubmission[] @relation("SubmittedBy")
  reviews       PersonSubmission[] @relation("ReviewedBy")
  activityLogs  ActivityLog[]

  @@map("users")
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============================================================
// DOMAIN TABLES
// ============================================================

model Person {
  id                 String     @id @default(cuid())
  fullName           String
  nickname           String?
  gender             Gender
  isAlive            Boolean    @default(true)
  generationNumber   Int?
  familyBranch       String?

  // Relasi keluarga
  fatherId           String?
  motherId           String?
  father             Person?    @relation("FatherChildren", fields: [fatherId], references: [id], onDelete: Cascade)
  mother             Person?    @relation("MotherChildren", fields: [motherId], references: [id], onDelete: Cascade)
  childrenAsFather   Person[]   @relation("FatherChildren")
  childrenAsMother   Person[]   @relation("MotherChildren")

  // Fallback nama (jika parent belum ada di DB)
  fatherNameFallback String?
  motherNameFallback String?

  // Data kelahiran
  birthDate          String?
  birthPlace         String?

  // Domisili (struktur alamat Indonesia)
  address            String?    // Jalan / alamat detail (Jl. Merdeka No. 10, RT 01/RW 05)
  kelurahan          String?    // Kelurahan / Desa
  kecamatan          String?    // Kecamatan
  kabupaten          String?    // Kabupaten / Kota
  province           String?    // Provinsi
  country            String?    @default("Indonesia")
  latitude           Float?     // Koordinat GPS
  longitude          Float?     // Koordinat GPS
  phone              String?

  // Data wafat
  deathDate          String?
  deathPlace         String?

  // Data makam (struktur alamat sama)
  graveAddress       String?    // Jalan / alamat makam
  graveKelurahan     String?    // Kelurahan makam
  graveKecamatan     String?    // Kecamatan makam
  graveKabupaten     String?    // Kabupaten / Kota makam
  graveProvince      String?    // Provinsi makam
  graveLatitude      Float?     // Koordinat GPS makam
  graveLongitude     Float?     // Koordinat GPS makam
  graveNotes         String?

  // Foto
  photoUrl           String?

  // Status
  linkStatus         LinkStatus @default(UNLINKED)
  status             DataStatus @default(PENDING)

  // Pernikahan
  marriagesAsHusband Marriage[] @relation("Husband")
  marriagesAsWife    Marriage[] @relation("Wife")

  // Adopsi
  adoptionsAsChild   Adoption[] @relation("AdoptedChild")
  adoptionsAsParent  Adoption[] @relation("AdoptiveParent")

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([fatherId])
  @@index([motherId])
  @@index([linkStatus])
  @@index([generationNumber])
  @@map("persons")
}

model Marriage {
  id            String         @id @default(cuid())
  husbandId     String
  wifeId        String
  husband       Person         @relation("Husband", fields: [husbandId], references: [id], onDelete: Cascade)
  wife          Person         @relation("Wife", fields: [wifeId], references: [id], onDelete: Cascade)
  marriageDate  String?
  marriagePlace String?
  divorceDate   String?
  status        MarriageStatus @default(MARRIED)
  marriageOrder Int            @default(1)
  createdAt     DateTime       @default(now())

  @@index([husbandId])
  @@index([wifeId])
  @@map("marriages")
}

model Adoption {
  id              String   @id @default(cuid())
  childId         String
  adoptiveParentId String
  child           Person   @relation("AdoptedChild", fields: [childId], references: [id], onDelete: Cascade)
  adoptiveParent  Person   @relation("AdoptiveParent", fields: [adoptiveParentId], references: [id], onDelete: Cascade)
  adoptionDate    String?
  notes           String?
  createdAt       DateTime @default(now())

  @@map("adoptions")
}

model PersonSubmission {
  id               String     @id @default(cuid())
  submittedById    String
  submittedBy      user       @relation("SubmittedBy", fields: [submittedById], references: [id])
  personData       Json
  changeType       ChangeType
  targetPersonId   String?
  targetPersonName String?
  status           DataStatus @default(PENDING)
  adminNote        String?
  reviewedById     String?
  reviewedBy       user?      @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime   @default(now())

  @@index([submittedById])
  @@index([status])
  @@map("person_submissions")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      user     @relation(fields: [userId], references: [id])
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("activity_logs")
}

// ============================================================
// ENUMS
// ============================================================

enum Gender {
  MALE
  FEMALE
}

enum LinkStatus {
  LINKED
  UNLINKED
}

enum DataStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MarriageStatus {
  MARRIED
  DIVORCED
  WIDOWED
}

enum ChangeType {
  ADD
  EDIT
  DELETE
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
